# ─────────────────────────────────────────────────────────────────────────────
# Voltio — variables de entorno
#
# Copiar a `.env` y completar. Una instalación NUEVA arranca en modo demo y
# funciona de punta a punta con solo las variables de la sección OBLIGATORIAS:
# pagos, envíos y comprobantes se resuelven con adaptadores simulados.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════ MODO DE LA TIENDA ═════════════════════════════

# demo       → pagos simulados, envíos simulados, banner visible en el storefront.
# production → proveedores reales (requiere las credenciales de más abajo).
#
# Si no se define, se asume "demo". Es deliberado: una instalación sin
# configurar no debe poder intentar un cobro real. Ver lib/config/store-mode.ts.
STORE_MODE=demo


# ══════════════════════════════ OBLIGATORIAS ═════════════════════════════════

# PostgreSQL. `DATABASE_URL` es la pooled (runtime), `DIRECT_URL` la directa
# (solo la usa `prisma migrate`). En Supabase: Project Settings → Database.
DATABASE_URL="postgresql://user:pass@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# NextAuth. `NEXTAUTH_SECRET` también firma la cookie de carrito de invitado.
# Generar con: openssl rand -hex 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""


# ══════════════════════ SOLO CON STORE_MODE=production ═══════════════════════

# ── Pagos ────────────────────────────────────────────────────────────────────
# Cuál de los proveedores reales usar. Default: MERCADO_PAGO (es el único con
# el checkout terminado; Stripe tiene el adapter pero no el widget montado).
PAYMENT_PROVIDER="MERCADO_PAGO"

# Mercado Pago → panel de desarrolladores → tus integraciones → credenciales.
# El WEBHOOK_SECRET es la "clave secreta" de la notificación, NO el access token.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# Stripe. ⚠️ Antes de activarlo: `Order.currency` se setea en USD para Stripe
# mientras el catálogo está en ARS — hay que resolver la moneda primero.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Envíos ───────────────────────────────────────────────────────────────────
# mock | correo-argentino | andreani
# Los dos couriers reales son stubs: lanzan hasta que se implementen. Ver los
# comentarios de lib/shipping/<courier>-provider.ts para el checklist completo.
SHIPPING_PROVIDER="mock"

# Correo Argentino (requiere cuenta de Mi Correo Empresas, no una particular).
CORREO_ARGENTINO_API_KEY=""
CORREO_ARGENTINO_CUSTOMER_ID=""
CORREO_ARGENTINO_AGREEMENT_ID=""
CORREO_ARGENTINO_ORIGIN_POSTAL_CODE=""

# Andreani (requiere contrato + alta en developers.andreani.com).
ANDREANI_API_KEY=""
ANDREANI_CLIENT_NUMBER=""
ANDREANI_CONTRACT_NUMBER=""
ANDREANI_ORIGIN_POSTAL_CODE=""


# ═══════════════════════════════ OPCIONALES ══════════════════════════════════

# Emails transaccionales (Resend). Sin esto el checkout funciona igual: el envío
# de la confirmación es best-effort y solo se loguea si falta configuración.
# ⚠️ El remitente de sandbox (onboarding@resend.dev) SOLO puede enviar al email
# de la cuenta de Resend. Para producción hay que verificar un dominio propio.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Subida de imágenes desde el panel admin (Cloudinary). Sin esto se puede
# administrar todo menos cargar imágenes nuevas.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Login con Google. Sin esto queda solo email + contraseña.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cron de expiración de órdenes pendientes (vercel.json → /api/cron/expire-orders).
# ⚠️ Hay que configurarlo TAMBIÉN en el dashboard de Vercel, no alcanza el .env
# local: los cron jobs solo corren en un proyecto deployado.
CRON_SECRET=""

# Redis (carritos de invitado). Hoy el carrito de invitado usa Postgres +
# cookie firmada, así que esto no es necesario.
REDIS_URL=""
