generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) - usado en runtime
  directUrl = env("DIRECT_URL")   // conexión directa - usado solo por `prisma migrate`
}

// ---------- Usuarios y auth ----------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  accounts  Account[]
  sessions  Session[]
  cart      Cart?
  orderStatusChanges OrderStatusChange[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String  @id @default(cuid())
  userId     String? // null for guest addresses
  label      String? // "Casa", "Trabajo"
  street     String
  city       String
  state      String
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean @default(false)
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------- Catálogo ----------

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  categoryId  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  category   Category          @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  reviews    Review[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Variante = combinación puntual (ej: talle M / color azul), cada una con su
// propio precio, SKU y stock.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique
  priceCents    Int
  compareAtCents Int?
  attributes    Json     // { "talle": "M", "color": "azul" }
  stock         Int      @default(0)
  lowStockAlert Int      @default(5)

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems        CartItem[]
  orderItems       OrderItem[]
  stockMovements    StockMovement[]
}

enum StockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  RESERVATION
  RETURN
}

model StockMovement {
  id        String            @id @default(cuid())
  variantId String
  type      StockMovementType
  quantity  Int // positivo = entra stock, negativo = sale
  note      String?
  createdAt DateTime          @default(now())
  variant   ProductVariant    @relation(fields: [variantId], references: [id])
}

// ---------- Carrito ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique // null si es carrito de invitado (guardado en Redis + cookie)
  guestId   String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

// ---------- Órdenes y pagos ----------

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum PaymentProviderType {
  STRIPE
  MERCADO_PAGO
  // Proveedor simulado que se usa cuando STORE_MODE=demo. Es un valor de enum
  // real (no un flag) para que una orden pagada en una demo sea distinguible
  // de una orden pagada de verdad, para siempre y a nivel de datos.
  MOCK
}

model Order {
  id              String              @id @default(cuid())
  userId          String?             // nullable for guest orders
  guestId         String?             // nullable for guest orders
  status          OrderStatus         @default(PENDING_PAYMENT)
  subtotalCents   Int
  discountCents   Int                 @default(0)
  taxCents        Int                 @default(0)
  shippingCents   Int                 @default(0)
  totalCents      Int
  currency        String              @default("USD")
  couponId        String?
  paymentProvider PaymentProviderType
  paymentRef      String? // id de la transacción en Stripe/MP
  contactEmail    String? // payerEmail del checkout; único medio de contacto para guests
  // Envío: qué adapter generó el envío y con qué id de tracking. Se completan
  // cuando el pago se aprueba (ver process-payment-event.ts). `shippingProvider`
  // es un string y no un enum a propósito: el set de couriers depende del país
  // de la instalación y no queremos una migración por cada courier nuevo.
  shippingProvider String?
  trackingId       String?
  shipmentCreatedAt DateTime?
  // Denormalized address snapshot (for historical accuracy and idempotency)
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  postalCode      String
  country         String
  phone           String?
  // Expiration for pending payments
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user    User?     @relation(fields: [userId], references: [id])
  coupon  Coupon?   @relation(fields: [couponId], references: [id])
  items   OrderItem[]
  statusChanges OrderStatusChange[]
}

// Auditoría de cambios manuales de estado hechos por un admin desde el panel
// (los cambios automáticos de los webhooks/cron no pasan por acá).
model OrderStatusChange {
  id              String      @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus
  toStatus        OrderStatus
  changedByUserId String
  note            String?
  createdAt       DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedByUserId], references: [id])
}

// Idempotencia de webhooks: (provider, providerRef) identifica una notificación
// ya procesada — el webhook intenta crear esta fila antes de aplicar efectos
// (stock, email, carrito) y si ya existe (constraint único), no repite nada.
model PaymentEvent {
  id          String              @id @default(cuid())
  provider    PaymentProviderType
  providerRef String
  rawType     String
  // true cuando el evento lo generó el adapter simulado (STORE_MODE=demo) en
  // vez de un webhook real del proveedor. Sirve para poder distinguir/purgar
  // datos de demostración sin adivinar por el prefijo del providerRef.
  simulated   Boolean             @default(false)
  createdAt   DateTime            @default(now())

  @@unique([provider, providerRef])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  variantId  String
  quantity   Int
  priceCents Int // precio al momento de la compra (no referenciar precio actual)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

// ---------- Cupones ----------

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Int // porcentaje (1-100) o centavos, según type
  minOrderCents Int?
  maxUses       Int?
  usedCount     Int        @default(0)
  expiresAt     DateTime?
  isActive      Boolean    @default(true)
  orders        Order[]
}

// ---------- Reviews ----------

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int // 1-5
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
}
